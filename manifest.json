{
  "manifest_version": 3,
  "name": "Insight NG",
  "description": "Know how you spend your time online. 100% local and private.",
  "homepage_url": "https://github.com/probecat/firefox-insight",
  "version": "0.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "insight-ng@kobioxide.gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Insight",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["tabs", "storage", "idle", "alarms", "scripting"],
  "optional_host_permissions": ["*://*/*"]
}
